# ==========================================
# EV CHARGE INTELLIGENCE PLATFORM ENVIRONMENT
# ==========================================

# Flask & Security Configuration
FLASK_ENV=production
SECRET_KEY=
JWT_SECRET_KEY=
PORT=5000
HOST=0.0.0.0

# Database Configuration (Docker Compose uses PostgreSQL, local fallback uses SQLite)
POSTGRES_DB=ev_charge_db
POSTGRES_USER=ev_user
POSTGRES_PASSWORD=
# Docker Compose constructs DATABASE_URL from the POSTGRES_* values above.

# AI Chatbot Configuration
# Supported providers: 'auto', 'gemini', 'openai', 'ollama', 'native'
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=gemini-1.5-flash

# File Upload Limit (bytes, default: 32MB)
MAX_CONTENT_LENGTH=33554432
